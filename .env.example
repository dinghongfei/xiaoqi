# 由 ./install.sh 写入。禁止从其它目录拷贝生产密钥，禁止编造凭证。

# --- 飞书（必填：机器人收消息、回卡片、读写文档）---
# 企业自建应用 App ID（https://open.feishu.cn/app）。只走本机长连接，不用 Webhook。
FEISHU_APP_ID=
# 同一应用的 App Secret，和 App ID 成对使用。
FEISHU_APP_SECRET=
# 开放平台「事件与回调」里的 Encrypt Key。未开启加密可留空。
FEISHU_ENCRYPT_KEY=
# 开放平台「事件与回调」里的 Verification Token。未开启校验可留空。
FEISHU_VERIFICATION_TOKEN=

# --- Hugo 演示站与本地预览 ---
# Hugo 站点根目录（相对项目根目录）。仓库已带演示站，不要 hugo new site。
HUGO_ROOT=site
# 本地预览目录：deploy-local 把 public/ 拷到这里；preview-http / 云端上传 / 清理也读它。
HUGO_DEPLOY_DIR=preview
# 预览站点对外地址。公众号 HTML 里的图片会拼成这个前缀的绝对 URL。
SITE_BASE_URL=http://127.0.0.1:1314
# 本机预览 HTTP 服务绑定地址（scripts/start.sh → preview-http）。
PREVIEW_HOST=127.0.0.1
# 本机预览 HTTP 服务端口，默认 http://127.0.0.1:1314/
PREVIEW_PORT=1314
# Hugo 可执行文件。留空则用 PATH 里的 hugo，或 site/hugo（若存在）。
# HUGO_BIN=
# hugo 构建超时（秒）。deploy-local 跑太久会按这个掐掉。
HUGO_BUILD_TIMEOUT=120

# --- 工作区状态（下载/转换产物，不是会话记忆）---
# SQLite：记下已处理文档/媒体，避免重复下载。
STATE_DB_PATH=data/state.db
# 上次任务摘要（token、slug、预览 URL）。再出公众号或发卡片时可先读它。
LAST_JOB_PATH=data/last-job.json
# 单次下载任务的中间文件目录（markdown/xml 等）。clean-generated 会清掉。
JOBS_DIR=data/jobs

# --- lark-cli（Skills 拉文档、下媒体、写回飞书）---
# lark-cli 可执行文件名或路径。
LARK_CLI_BIN=lark-cli
# lark-cli 身份：必须用 bot（应用机器人），不要用个人账号。
LARK_CLI_IDENTITY=bot
# 命名 profile。所有 lark-cli 调用都带 --profile 此值，避免和本机其它应用抢默认配置。
LARK_CLI_PROFILE=xiaoqi
# 拉文档/写回前，把 App ID/Secret 写入已安装的 lark-cli（config init）。不负责安装 CLI，也不做登录向导。false 则假定你已手动配好且与机器人同一应用。
LARK_CLI_SYNC_CONFIG=true

# --- 云端发布（deploy-cloud）---
# 发布口令。用户必须在话里带上同样的 sk，对不上就拒绝上传。
PUBLISH_SECRET_KEY=demo-sk
# 是否在上传后再 git push。默认关闭；即使设为 true，当前实现也不会真的 push。
GIT_PUSH_ENABLED=false
# 对象存储 CLI，默认阿里云 ossutil（aliyun ossutil）。
# OSSUTIL_BIN=aliyun ossutil
# OSS bucket 地址（如 oss://bucket/prefix/）。留空则云端发布返回「未开通」，只做本地预览。
OSS_BUCKET=
# ossutil 配置文件路径。留空则用工具自己的默认配置。
# OSSUTIL_CONFIG=

# --- 媒体压缩（compress-media）---
# 是否压缩 site/static 下的图片/视频。false 则整步跳过。
MEDIA_COMPRESS_ENABLED=true
# ffmpeg 可执行文件。未安装时 Skill 会跳过压缩并说明，官网仍可预览。
FFMPEG_BIN=ffmpeg

# --- 本机 Agent CLI（飞书宿主把用户消息交给它编排 Skills）---
# 指定 claude / opencode / codex 的路径。留空则按 PATH 探测：claude → opencode → codex。
# 不要填 cursor / trae：飞书宿主不会拉起它们。
# AGENT_BIN=
# Agent 一次编排的超时（秒）。飞书无人值守任务超时后会失败并尝试回卡片。
AGENT_TIMEOUT=600
